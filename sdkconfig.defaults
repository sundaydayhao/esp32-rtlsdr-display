CONFIG_IDF_TARGET="esp32s31"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_USB_HOST_ENABLE_ENUM_FILTER_CALLBACK=y
CONFIG_USB_HOST_DEBOUNCE_DELAY_MS=800
CONFIG_USB_HOST_RESET_HOLD_MS=100
CONFIG_USB_HOST_RESET_RECOVERY_MS=250
CONFIG_USB_HOST_SET_ADDR_RECOVERY_MS=50
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_RTLSDR_SAMPLE_RATE=288000
CONFIG_RTLSDR_BULK_TRANSFER_SIZE=4096
CONFIG_RTLSDR_NUM_TRANSFERS=8
CONFIG_WATERFALL_TARGET_FPS=20
CONFIG_FM_RECEIVER_AUDIO_RATE_HZ=48000
CONFIG_FM_RECEIVER_VOLUME_PERCENT=35
# CONFIG_FM_RECEIVER_NFM_MODE is not set
CONFIG_FM_RECEIVER_AUDIO_OUTPUT=y
CONFIG_FM_RECEIVER_AUDIO_I2C_PORT=0
CONFIG_FM_RECEIVER_AUDIO_I2C_SDA_GPIO=0
CONFIG_FM_RECEIVER_AUDIO_I2C_SCL_GPIO=1
CONFIG_FM_RECEIVER_AUDIO_I2S_PORT=1
CONFIG_FM_RECEIVER_AUDIO_I2S_MCLK_GPIO=-1
CONFIG_FM_RECEIVER_AUDIO_I2S_BCLK_GPIO=3
CONFIG_FM_RECEIVER_AUDIO_I2S_WS_GPIO=4
CONFIG_FM_RECEIVER_AUDIO_I2S_DOUT_GPIO=5
CONFIG_FM_RECEIVER_AUDIO_I2S_DIN_GPIO=6
CONFIG_FM_RECEIVER_AUDIO_PA_GPIO=7
# CONFIG_CODEC_ES8311_SUPPORT is not set
# CONFIG_CODEC_ES7210_SUPPORT is not set
# CONFIG_CODEC_ES7243_SUPPORT is not set
# CONFIG_CODEC_ES7243E_SUPPORT is not set
# CONFIG_CODEC_ES8156_SUPPORT is not set
# CONFIG_CODEC_AW88298_SUPPORT is not set
CONFIG_CODEC_ES8389_SUPPORT=y
# CONFIG_CODEC_ES8374_SUPPORT is not set
# CONFIG_CODEC_ES8388_SUPPORT is not set
# CONFIG_CODEC_TAS5805M_SUPPORT is not set
