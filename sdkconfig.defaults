CONFIG_IDF_TARGET="esp32s31"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_USB_HOST_ENABLE_ENUM_FILTER_CALLBACK=y
CONFIG_USB_HOST_DEBOUNCE_DELAY_MS=500
CONFIG_USB_HOST_RESET_HOLD_MS=60
CONFIG_USB_HOST_RESET_RECOVERY_MS=120
CONFIG_USB_HOST_SET_ADDR_RECOVERY_MS=20
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_WATERFALL_TARGET_FPS=20
CONFIG_FM_RECEIVER_AUDIO_RATE_HZ=48000
CONFIG_FM_RECEIVER_VOLUME_PERCENT=80
# CONFIG_FM_RECEIVER_NFM_MODE is not set
# CONFIG_FM_RECEIVER_I2S_OUTPUT is not set
